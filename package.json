  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && npm run prerender",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "tsx scripts/prerender.ts",
    "check-dist": "tsx scripts/check-dist.ts",
    "design:lint": "design.md lint DESIGN.md",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "graph": "echo \"run /understand in Claude Code to rebuild .understand-anything/\""
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
